{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/projects/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "heading-order": [
          "error",
          {
            "minScore": 1
          }
        ],
        "aria-prohibited-attr": [
          "error",
          {
            "minScore": 1
          }
        ],
        "lcp-lazy-loaded": [
          "error",
          {
            "minScore": 1
          }
        ],
        "unused-javascript": [
          "error",
          {
            "maxLength": 0
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
