---
import SocialIcon from "./SocialIcon.astro";
import { profile } from "../data/portfolio.json";

const links = [
  {
    label: "GitHub",
    href: profile.github,
    external: true,
    icon: "github" as const,
  },
  {
    label: "LinkedIn",
    href: profile.linkedin,
    external: true,
    icon: "linkedin" as const,
  },
  {
    label: "Email",
    href: `mailto:${profile.email}`,
    external: false,
    icon: "email" as const,
  },
];
---

<nav class="social-links contact-socials" aria-label="Contact links">
  {links.map(({ label, href, external, icon }) => (
    <a
      href={href}
      aria-label={label}
      title={label}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
      data-social-link
    >
      <SocialIcon name={icon} />
    </a>
  ))}
</nav>
