---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Card } from '@/components/ui/card';
import TechIcon from './TechIcon.astro';
import { projects } from '../data/portfolio.json';
interface Props {
  project: (typeof projects)[number];
  headingLevel?: 'h2' | 'h3';
  priority?: boolean;
}
const { project, headingLevel: Heading = 'h3', priority = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*', { eager: true });
const image = project.image ? images[`../assets/projects/${project.image.split('/').pop()}`]?.default : undefined;
if (project.image && !image) throw new Error(`Missing project image: ${project.image}`);
const destinations = project.links.map(link => {
  const source = /github|repo/i.test(link.name);
  const docs = /doc/i.test(link.name);
  const packageLink = /pypi/i.test(link.name);
  const icon: 'github' | 'book' | 'package' | 'globe' = source ? 'github' : docs ? 'book' : packageLink ? 'package' : 'globe';
  const label = source ? 'Source code' : docs ? 'Documentation' : packageLink ? 'Python package' : 'Live website';
  const tooltip = source || docs || packageLink ? label : link.href;
  return { ...link, icon, label, tooltip };
});
---
<Card className="project-card" role="article">
  {image && (
    <div class="project-preview">
      <Image src={image} alt={`${project.title} preview`} width={640} height={360}
        widths={[320, 480, 640]} sizes="(max-width: 639px) calc(100vw - 48px), (max-width: 1023px) calc((100vw - 64px) / 2), 375px"
        fit="cover" position="top" format="webp" quality={80}
        loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
    </div>
  )}
  <div class="project-info">
    <div class="project-heading">
      <Heading>{project.links[0] ? <a href={project.links[0].href} target="_blank" rel="noopener noreferrer">{project.title}</a> : project.title}</Heading>
      <div class="project-destinations">
        {destinations.map(link => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.title}: ${link.label}`}>
            <Icon name={link.icon} size={19} />
            <span class="destination-tooltip" aria-hidden="true">{link.tooltip}</span>
          </a>
        ))}
      </div>
    </div>
    <p>{project.description}</p>
    <div class="project-technologies" role="group" aria-label={`${project.title} technologies`}>{project.tech.map(tech => <TechIcon name={tech} />)}</div>
  </div>
</Card>
