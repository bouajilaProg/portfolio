---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portfolio v3" description="The starting point for my next portfolio.">
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center px-6 py-24">
    <p class="text-sm font-medium uppercase tracking-widest text-teal-400">Portfolio v3</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">A fresh start.</h1>
    <p class="mt-6 max-w-lg text-lg leading-relaxed text-slate-400">
      Built with Astro and Tailwind CSS. Ready for the next version of my portfolio.
    </p>
  </main>
</Layout>
