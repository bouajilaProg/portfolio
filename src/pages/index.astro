---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import SocialIcon from "../components/SocialIcon.astro";
import TechIcon from "../components/TechIcon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Contributions from "../components/Contributions.astro";
import Contact from "../components/Contact.astro";
import {
  profile,
  projects,
  experience,
  education,
} from "../data/portfolio.json";

---

<Layout title={`${profile.name} | ${profile.title}`}>
  <main id="main" class="home-page">
    <section id="about" class="profile-section" aria-labelledby="profile-name">
      <div class="profile-header">
        <img
          class="avatar"
          src="/images/profile.webp"
          alt={profile.name}
          width="64"
          height="64"
        />
        <div>
          <h1 id="profile-name">{profile.name}</h1>
          <p class="profile-role">Product Manager | Full Stack Developer</p>
        </div>
      </div>
      <div class="profile-details">
        <div class="profile-contact-details">
          <span class="meta-value">
            <Icon name="pin" size={16} />
            Tunisia
          </span>
          <span class="profile-separator" aria-hidden="true">|</span>
          <a class="meta-value" href={`mailto:${profile.email}`}>
            <Icon name="mail" size={16} />
            <span class="profile-email-address">
              <span class="email-fragment">{profile.email.split("@")[0]}</span><wbr /><span class="email-fragment email-domain">@{profile.email.split("@")[1]}</span>
            </span>
          </a>
        </div>
        <nav class="profile-socials" aria-label="Profile social links">
          <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="bouajilaProg on GitHub">
            <SocialIcon name="github" size={17} />
            <span>{new URL(profile.github).pathname.split("/").filter(Boolean)[0]}</span>
          </a>
          <span class="profile-separator" aria-hidden="true">|</span>
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${profile.name} on LinkedIn`}>
            <SocialIcon name="linkedin" size={17} />
            <span>{profile.name}</span>
          </a>
        </nav>
      </div>
      <p class="bio">{profile.bio}</p>
    </section>
    <Contributions />
    <section
      id="projects"
      class="section-block"
      aria-labelledby="projects-heading"
    >
      <div class="section-heading">
        <h2 id="projects-heading">Featured Projects</h2>
        <a class="text-link" href="/projects/">
          View all projects <Icon name="arrow" size={16} />
        </a>
      </div>
      <div class="projects-grid">
        {projects.filter((project) => project.featured).map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>
    <section id="experience" class="section-block" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <div class="timeline-list">
        {experience.map((entry) => (
          <article class="timeline-entry" data-current={entry.date.includes("Present") ? "true" : undefined}>
            <div class="timeline-heading">
              <div class="entry-title">
                <h3>{entry.title}</h3>
                <span>·</span>
                <span>{entry.subtitle}</span>
              </div>
              <span class="date-label">{entry.date}</span>
            </div>
            <p class="entry-description">{entry.description}</p>
            <div class="entry-tech">
              {entry.tags.map((tag) => (
                <TechIcon name={tag} />
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
    <section id="education" class="section-block" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <div class="timeline-list">
        {education.map((entry) => (
          <article class="timeline-entry" data-current={entry.date.includes("Present") ? "true" : undefined}>
            <div class="timeline-heading">
              <h3>{entry.subtitle}</h3>
              <span class="date-label">{entry.date}</span>
            </div>
            <p class="entry-subtitle">{entry.title}</p>
            <p class="entry-description">{entry.description}</p>
            {entry.tags.length > 0 && (
              <p class="education-tags">{entry.tags.join(" · ")}</p>
            )}
          </article>
        ))}
      </div>
    </section>
    <Contact />
  </main>
</Layout>
